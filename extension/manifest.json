{
  "manifest_version": 3,
  "name": "Doomscroll Unfocused",
  "version": "0.2.0",
  "description": "Keep Instagram and CNN from pausing playback when you switch tabs or windows.",
  "minimum_chrome_version": "119",
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*", "https://*.cnn.com/*"],
      "js": ["keep-playing.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
