{
  "manifest_version": 3,
  "name": "Doomscroll Unfocused",
  "version": "0.4.3",
  "description": "Keep videos playing when you switch tabs. Enable it per site, with Instagram and CNN included.",
  "minimum_chrome_version": "119",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.cnn.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Doomscroll Unfocused",
    "default_popup": "popup.html"
  }
}
