{
  "name": "doomscroll-unfocused",
  "version": "0.4.2",
  "private": true,
  "description": "A Chrome extension to keep videos playing when you switch tabs, with per-site controls.",
  "scripts": {
    "build": "bun run icons && bun build ./src/keep-playing.ts ./src/keep-scrolling.ts ./src/background.ts ./src/popup.ts --target browser --format iife --outdir extension",
    "check": "tsc --noEmit",
    "package": "bun run build && bash scripts/package.sh",
    "icons": "bun scripts/icons.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.5",
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "packageManager": "bun@1.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikifar2012/doomscroll-unfocused.git"
  },
  "homepage": "https://github.com/ikifar2012/doomscroll-unfocused#readme",
  "bugs": {
    "url": "https://github.com/ikifar2012/doomscroll-unfocused/issues"
  }
}
